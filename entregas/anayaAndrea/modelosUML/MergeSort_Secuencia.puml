@startuml
skinparam monochrome true
skinparam shadowing false
autonumber

actor "Cliente / main" as main
participant "MergeSort" as ms

main -> ms : ordenar(array, 0, 5)\n[5, 2, 8, 1, 9, 3]
activate ms

ms -> ms : ordenar(array, 0, 2)\n[5, 2, 8]
activate ms

ms -> ms : ordenar(array, 0, 1)\n[5, 2]
activate ms

ms -> ms : ordenar(array, 0, 0)\n[5]
activate ms
note right: Caso base
ms --> ms : return
deactivate ms

ms -> ms : ordenar(array, 1, 1)\n[2]
activate ms
note right: Caso base
ms --> ms : return
deactivate ms

ms -> ms : fusionar(array, 0, 0, 1)
activate ms
note right: Fusiona [5] y [2] -> [2, 5]
ms --> ms : return
deactivate ms

ms --> ms : return
deactivate ms

ms -> ms : ordenar(array, 2, 2)\n[8]
activate ms
note right: Caso base
ms --> ms : return
deactivate ms

ms -> ms : fusionar(array, 0, 1, 2)
activate ms
note right: Fusiona [2, 5] y [8] -> [2, 5, 8]
ms --> ms : return
deactivate ms

ms --> ms : return
deactivate ms

ms -> ms : ordenar(array, 3, 5)\n[1, 9, 3]
activate ms

ms -> ms : ordenar(array, 3, 4)\n[1, 9]
activate ms

ms -> ms : ordenar(array, 3, 3)\n[1]
activate ms
note right: Caso base
ms --> ms : return
deactivate ms

ms -> ms : ordenar(array, 4, 4)\n[9]
activate ms
note right: Caso base
ms --> ms : return
deactivate ms

ms -> ms : fusionar(array, 3, 3, 4)
activate ms
note right: Fusiona [1] y [9] -> [1, 9]
ms --> ms : return
deactivate ms

ms --> ms : return
deactivate ms

ms -> ms : ordenar(array, 5, 5)\n[3]
activate ms
note right: Caso base
ms --> ms : return
deactivate ms

ms -> ms : fusionar(array, 3, 4, 5)
activate ms
note right: Fusiona [1, 9] y [3] -> [1, 3, 9]
ms --> ms : return
deactivate ms

ms --> ms : return
deactivate ms

ms -> ms : fusionar(array, 0, 2, 5)
activate ms
note right: Fusiona [2, 5, 8] y [1, 3, 9]\n-> [1, 2, 3, 5, 8, 9]
ms --> ms : return
deactivate ms

ms --> main : return
deactivate ms

@enduml
